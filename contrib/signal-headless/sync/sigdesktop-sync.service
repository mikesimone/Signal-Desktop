# Installed to /etc/systemd/system/ on Six; see sigdesktop-sync.sh.
[Unit]
Description=Merge upstream Signal Desktop into the fork and redeploy sigdesktop (via claude -p)
Wants=network-online.target
After=network-online.target docker.service

[Service]
Type=oneshot
User=msimone
Group=msimone
Environment=HOME=/home/msimone
Environment=PATH=/home/msimone/.local/bin:/usr/local/bin:/usr/bin:/bin
WorkingDirectory=/home/msimone/Signal-Desktop
ExecStart=/usr/local/bin/sigdesktop-sync
# A merge plus a full Signal build can take a while.
TimeoutStartSec=3h
Nice=10
