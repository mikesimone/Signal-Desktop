# Copy to /etc/sigdesktop-sync.env (readable by the sync user) and edit.
# Read by sigdesktop-sync on every run.

# The fork clone the container is built from (contrib/signal-headless).
SYNC_REPO=/home/signal/Signal-Desktop
# Your fork on GitHub, owner/name. The sync pushes merged upstream here.
SYNC_FORK=your-name/Signal-Desktop
# The chat page's base URL, as your reverse proxy serves it.
SYNC_SITE=https://signal.example.net
# Optional: a command that gets the report as its one argument.
#SYNC_NOTIFY=/usr/local/bin/notify-me
# Optional: where Claude Code is installed (default ~/.local/bin/claude).
#SYNC_CLAUDE=/usr/local/bin/claude
