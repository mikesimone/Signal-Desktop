+// Backchannel (contrib/backchannel): one-time import of a local backup snapshot into a freshly linked, still empty
+// account. Everything comes from the container's environment; the recovery key is read from a file mounted into the
+// container and is never logged. Returns null when the feature is not configured.
+ipc.handle('backchannel-local-import-config', async () => {
+  const dir = process.env.BACKCHANNEL_LOCAL_IMPORT_DIR;
+  const keyFile = process.env.BACKCHANNEL_RECOVERY_KEY_FILE;
+  if (!dir || !keyFile) {
+    return null;
+  }
+  const key = (await fsExtra.readFile(keyFile, 'utf8'))
+    .toLowerCase()
+    .replace(/[^a-z0-9]/g, '');
+  if (key.length !== 64) {
+    log.error('backchannel-local-import-config: the recovery key must be 64 characters');
+    return null;
+  }
+  const days = Number(process.env.BACKCHANNEL_IMPORT_DAYS || '7');
+  return { dir, key, days: Number.isFinite(days) && days > 0 ? days : 7 };
+});
