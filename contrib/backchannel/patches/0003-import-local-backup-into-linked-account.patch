+  // Backchannel (contrib/backchannel): import a local backup snapshot into an already linked account, using the
+  // recovery key from a file. The importer is written for an empty database (link & sync / fresh install) and adds
+  // chats and messages without merging, so this refuses to run over existing history. Returns true if it imported.
+  public async backchannelImportLocalBackup(): Promise<boolean> {
+    const logId = 'backchannelImportLocalBackup';
+    try {
+      const config: { dir: string; key: string; days: number } | null =
+        await ipcRenderer.invoke('backchannel-local-import-config');
+      if (!config) {
+        return false;
+      }
+
+      const existing = await DataReader.getMessageCount();
+      if (existing > 0) {
+        log.info(`${logId}: database already has ${existing} messages, not importing`);
+        return false;
+      }
+
+      const { success, error } = await validateLocalBackupStructure(config.dir);
+      if (!success) {
+        log.error(`${logId}: ${config.dir} is not a usable snapshot: ${error}`);
+        return false;
+      }
+
+      const have = itemStorage.get('accountEntropyPool');
+      if (have && have !== config.key) {
+        log.error(`${logId}: the recovery key does not match this account's key, not importing`);
+        return false;
+      }
+      if (!have) {
+        await itemStorage.put('accountEntropyPool', config.key);
+        log.info(`${logId}: stored the recovery key (this device had none)`);
+      }
+
+      setBackchannelImportSince(Date.now() - config.days * 24 * 60 * 60 * 1000);
+      this.#localBackupSnapshotDir = config.dir;
+      log.info(`${logId}: importing the last ${config.days} days from ${config.dir}`);
+      try {
+        await this.importLocalBackup();
+      } finally {
+        setBackchannelImportSince(undefined);
+      }
+      log.info(`${logId}: done`);
+      return true;
+    } catch (error) {
+      log.error(`${logId}: failed, continuing without it: ${Errors.toLogFormat(error)}`);
+      return false;
+    }
+  }
+
   public isLocalBackupStaged(): boolean {
     return Boolean(this.#localBackupSnapshotDir);
   }
